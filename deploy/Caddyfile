# Caddy terminates TLS (automatic Let's Encrypt) and proxies to the
# quorum-mcp container. Used by docker-compose.yml -- "quorum" is the
# compose service name, reachable on the internal network only.

quorum-mcp.terradev.cloud {
    @health path /health
    handle @health {
        respond "ok" 200
    }
    handle {
        reverse_proxy quorum:8000
    }
}
